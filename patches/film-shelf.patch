@@ -0,0 +1,74 @@
+package com.fongmi.android.tv.ui.activity;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class FamilyPlaybackWaitPolicyTest {
+    @Test public void explicitLoginChallengesAreNotPlaybackFailures() {
+        for (String s : new String[]{"请打开客户端扫码登录", "請登入", "需会员登录", "扫码超时",
+                "二维码已过期", "登录已过期", "SCAN QR CODE now", "Sign-in required", "Please log in"}) {
+            assertEquals(s, FamilyPlaybackWait.Failure.LOGIN, FamilyPlaybackWait.classifyFailure(s));
+        }
+    }
+
+    @Test public void absenceOfLoginOrGenericTimeoutDoesNotLookLikeAChallenge() {
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("网络连接超时"));
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("HTTP timed out"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("本线路无需扫码登录，网络错误"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("QR artwork load failed"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("HTTP 404"));
+    }
+
+    @Test public void unrelatedNegationDoesNotHideExplicitLoginOnThisLine() {
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("不需要扫码登录，网络错误"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("请刷新，登录接口返回错误"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN,
+                FamilyPlaybackWait.classifyFailure("旧版不用扫码登录；当前线路请扫码授权"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN,
+                FamilyPlaybackWait.classifyFailure("Sign-in is not required on the old line. Please log in to use this line"));
+    }
+
+    @Test public void independentQaCoversNegatedAndExpiredQrChallenges() {
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("不需扫码，网络连接超时"));
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("无需会员登录，网络超时"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("No scan QR code required"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN, FamilyPlaybackWait.classifyFailure("QR code expired"));
+    }
+
+    @Test public void focusedWaitStartsFreshWhenCoveredPastDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(9_999, false));
+        assertFalse(wait.shouldPrompt(10_000, true));
+        assertFalse(wait.shouldPrompt(120_000, true));
+        assertFalse(wait.shouldPrompt(140_000, false));
+        assertFalse(wait.shouldPrompt(149_999, false));
+        assertTrue(wait.shouldPrompt(150_000, false));
+        assertTrue(wait.shouldPrompt(170_000, false));
+        assertFalse(wait.shouldPrompt(171_000, false));
+    }
+
+    @Test public void rebufferingRearmsAfterReadyWithoutResettingOnDuplicateEvents() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(100);
+        wait.beginIfIdle(5_100);
+        assertTrue(wait.shouldPrompt(10_100, false));
+        wait.stop(); // READY, or successful recovery.
+        wait.beginIfIdle(30_000);
+        assertFalse(wait.shouldPrompt(39_999, false));
+        wait.beginIfIdle(39_999);
+        assertTrue(wait.shouldPrompt(40_000, false));
+    }
+
+    @Test public void stopAndStartClearsOldOverlayAndDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(100_000, true));
+        wait.stop();
+        assertFalse(wait.shouldPrompt(120_000, false));
+        wait.start(200_000);
+        assertFalse(wait.shouldPrompt(209_999, false));
+        assertTrue(wait.shouldPrompt(210_000, false));
+    }
+}
