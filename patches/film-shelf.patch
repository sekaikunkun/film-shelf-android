--- /dev/null
+++ b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWait.java
@@ -0,0 +1,66 @@
+package com.fongmi.android.tv.ui.activity;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/** Monotonic, request-scoped waiting policy; a visible QR dialog is not a failure. */
+final class FamilyPlaybackWait {
+    enum Failure { LOGIN, TIMEOUT, HARD }
+
+    private static final Pattern NO_LOGIN = Pattern.compile(
+            "(?:(?:无[需须]|無[需須]|不用|不需要?|不须|不須|不必|毋須)\\s*(?:扫码|掃碼|扫二维码|掃二維碼)(?:\\s*(?:登录|登入|授权|授權))?"
+            + "|(?:无[需须]|無[需須]|不用|不需要?|不须|不須|不必|毋須)\\s*(?:(?:会员|會員|账号|帳號|账户|帳戶)\\s*)?(?:登录|登入)"
+            + "|(?:sign[ -]?in|log[ -]?in) (?:is )?not required|no (?:log[ -]?in|sign[ -]?in) required"
+            + "|no (?:scan(?: (?:the )?qr(?: code)?)|qr(?: code)? scan) (?:is )?required|no need to (?:scan(?: (?:the )?qr(?: code)?)?|sign in|log in))");
+    private static final Pattern LOGIN = Pattern.compile(
+            "(?:请|請|需|先|等待)[^，。；、！？,.;!?\\r\\n]{0,8}(?:扫码|掃碼|扫二维码|掃二維碼|登录|登入)|"
+            + "(?:扫码|掃碼)[^，。；、！？,.;!?\\r\\n]{0,8}(?:登录|登入|授权|授權|超[时時]|过期|過期)|(?:二维码|二維碼)[^，。；、！？,.;!?\\r\\n]{0,8}(?:失效|过期|過期)|(?:未登录|未登入|登录已过期|登入已過期)|"
+            + "(?:scan (?:the )?qr(?: code)?|qr(?: code)? (?:has |is )?expired|sign[ -]?in required|log[ -]?in required|please (?:sign in|log in))");
+    private static final Pattern TIMEOUT = Pattern.compile(
+            "超[时時]|逾時|timed?[ -]?out|timeout|deadline exceeded");
+
+    static Failure classifyFailure(String message) {
+        String text = message == null ? "" : message.toLowerCase(Locale.ROOT);
+        if (LOGIN.matcher(NO_LOGIN.matcher(text).replaceAll("。")).find()) return Failure.LOGIN;
+        return TIMEOUT.matcher(text).find() ? Failure.TIMEOUT : Failure.HARD;
+    }
+
+    private static final long[] DEADLINES_MS = {10_000, 30_000};
+    private long started;
+    private int stage;
+    private boolean active;
+    private boolean qrWasVisible;
+
+    void start(long now) {
+        started = now;
+        stage = 0;
+        qrWasVisible = false;
+        active = true;
+    }
+
+    /** Rebuffering after READY gets a fresh budget, but duplicate buffering events do not postpone it. */
+    void beginIfIdle(long now) {
+        if (!active) start(now);
+    }
+
+    void stop() {
+        active = false;
+    }
+
+    boolean isActive() {
+        return active;
+    }
+
+    boolean shouldPrompt(long now, boolean qrVisible) {
+        if (!active) return false;
+        if (qrVisible) {
+            qrWasVisible = true;
+            return false;
+        }
+        if (qrWasVisible) start(now);
+        if (now - started < DEADLINES_MS[stage]) return false;
+        stage++;
+        if (stage == DEADLINES_MS.length) stop();
+        return true;
+    }
+}
diff --git a/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java
