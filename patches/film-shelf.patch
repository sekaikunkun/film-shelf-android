index 0000000000000000000000000000000000000000..f934b3f3dffb7eccf70cb5d400aaa1e35044dbe4
--- /dev/null
+++ b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java
@@ -0,0 +1,73 @@
+package com.fongmi.android.tv.ui.activity;
+
+import java.net.URI;
+import java.text.Normalizer;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+final class FamilyRouteProbePolicy {
+    static final int SOURCE_LIMIT = 6;
+    static final int ROUTE_LIMIT = 3;
+    static final int LOCAL_ROUTE_LIMIT = 6;
+    private static final Pattern EPISODE_NUMBER = Pattern.compile("(?:episode|ep\\.?|e|第)?\\s*0*([0-9]{1,4})\\s*(?:集|话|話)?");
+    static final int MIN_ADVANCE_MS = 350;
+
+    static String identity(String site, String id) {
+        return site.length() + ":" + site + id;
+    }
+
+    // Match labels, never a playlist position: lists can omit episodes or be reversed.
+    static int episodeIndex(String current, List<String> alternatives) {
+        String label = normalize(current);
+        if (label.isEmpty()) return -1;
+        int exact = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (!label.equals(normalize(alternatives.get(i)))) continue;
+            if (exact != -1) return -1;
+            exact = i;
+        }
+        if (exact != -1) return exact;
+        int number = episodeNumber(label);
+        if (number < 0) return -1;
+        int match = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (number != episodeNumber(normalize(alternatives.get(i)))) continue;
+            if (match != -1) return -1;
+            match = i;
+        }
+        return match;
+    }
+
+    private static String normalize(String label) {
+        return label == null ? "" : Normalizer.normalize(label, Normalizer.Form.NFKC).trim().toLowerCase(Locale.ROOT);
+    }
+
+    private static int episodeNumber(String label) {
+        var match = EPISODE_NUMBER.matcher(label);
+        return match.matches() ? Integer.parseInt(match.group(1)) : -1;
+    }
+
+    static boolean directMedia(String raw) {
+        if (raw == null || raw.length() > 4096) return false;
+        try {
+            URI url = URI.create(raw);
+            String scheme = url.getScheme();
+            String path = url.getPath();
+            return ("https".equalsIgnoreCase(scheme) || "http".equalsIgnoreCase(scheme))
+                    && url.getHost() != null && url.getUserInfo() == null && path != null
+                    && path.toLowerCase(Locale.ROOT).matches(".*[.](mp4|m4v|webm|mkv|m3u8|mpd|ts)$");
+        } catch (IllegalArgumentException ignored) {
+            return false;
+        }
+    }
+
+    static boolean plainCatalog(int type, boolean hasExtension, boolean hasHeaders) {
+        return (type == 0 || type == 1) && !hasExtension && !hasHeaders;
+    }
+
+    static boolean confirmed(boolean firstFrame, long firstPositionMs, long currentPositionMs) {
+        return firstFrame && currentPositionMs >= firstPositionMs
+                && currentPositionMs - firstPositionMs >= MIN_ADVANCE_MS;
+    }
+}
