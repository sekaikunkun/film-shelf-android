+    @Test public void matchesStayVisibleEvenWhenTheyCannotBeProbed() {
+        String url = "https://example.com/episode09.m3u8";
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.PROBE, FamilyRouteProbePolicy.localStatus(true, true, 1, url, 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.MANUAL_ONLY, FamilyRouteProbePolicy.localStatus(true, false, 3, url, 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.MANUAL_ONLY, FamilyRouteProbePolicy.localStatus(true, true, 1, "opaque-id", 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.LIMIT_REACHED,
+                FamilyRouteProbePolicy.localStatus(true, true, 1, url, FamilyRouteProbePolicy.LOCAL_ROUTE_LIMIT));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.NO_MATCH, FamilyRouteProbePolicy.localStatus(false, true, 1, url, 0));
