@@ -0,0 +1,66 @@
+package com.fongmi.android.tv.ui.activity;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/** Monotonic, request-scoped waiting policy; a visible QR dialog is not a failure. */
+final class FamilyPlaybackWait {
+    enum Failure { LOGIN, TIMEOUT, HARD }
+
+    private static final Pattern NO_LOGIN = Pattern.compile(
+            "(?:(?:无[需须]|無[需須]|不用|不需要?|不须|不須|不必|毋須)\\s*(?:扫码|掃碼|扫二维码|掃二維碼)(?:\\s*(?:登录|登入|授权|授權))?"
+            + "|(?:无[需须]|無[需須]|不用|不需要?|不须|不須|不必|毋須)\\s*(?:(?:会员|會員|账号|帳號|账户|帳戶)\\s*)?(?:登录|登入)"
+            + "|(?:sign[ -]?in|log[ -]?in) (?:is )?not required|no (?:log[ -]?in|sign[ -]?in) required"
+            + "|no (?:scan(?: (?:the )?qr(?: code)?)|qr(?: code)? scan) (?:is )?required|no need to (?:scan(?: (?:the )?qr(?: code)?)?|sign in|log in))");
+    private static final Pattern LOGIN = Pattern.compile(
+            "(?:请|請|需|先|等待)[^，。；、！？,.;!?\\r\\n]{0,8}(?:扫码|掃碼|扫二维码|掃二維碼|登录|登入)|"
+            + "(?:扫码|掃碼)[^，。；、！？,.;!?\\r\\n]{0,8}(?:登录|登入|授权|授權|超[时時]|过期|過期)|(?:二维码|二維碼)[^，。；、！？,.;!?\\r\\n]{0,8}(?:失效|过期|過期)|(?:未登录|未登入|登录已过期|登入已過期)|"
+            + "(?:scan (?:the )?qr(?: code)?|qr(?: code)? (?:has |is )?expired|sign[ -]?in required|log[ -]?in required|please (?:sign in|log in))");
+    private static final Pattern TIMEOUT = Pattern.compile(
+            "超[时時]|逾時|timed?[ -]?out|timeout|deadline exceeded");
+
+    static Failure classifyFailure(String message) {
+        String text = message == null ? "" : message.toLowerCase(Locale.ROOT);
+        if (LOGIN.matcher(NO_LOGIN.matcher(text).replaceAll("。")).find()) return Failure.LOGIN;
+        return TIMEOUT.matcher(text).find() ? Failure.TIMEOUT : Failure.HARD;
+    }
+
+    private static final long[] DEADLINES_MS = {10_000, 30_000};
+    private long started;
+    private int stage;
+    private boolean active;
+    private boolean qrWasVisible;
+
+    void start(long now) {
+        started = now;
+        stage = 0;
+        qrWasVisible = false;
+        active = true;
+    }
+
+    /** Rebuffering after READY gets a fresh budget, but duplicate buffering events do not postpone it. */
+    void beginIfIdle(long now) {
+        if (!active) start(now);
+    }
+
+    void stop() {
+        active = false;
+    }
+
+    boolean isActive() {
+        return active;
+    }
+
+    boolean shouldPrompt(long now, boolean qrVisible) {
+        if (!active) return false;
+        if (qrVisible) {
+            qrWasVisible = true;
+            return false;
+        }
+        if (qrWasVisible) start(now);
+        if (now - started < DEADLINES_MS[stage]) return false;
+        stage++;
+        if (stage == DEADLINES_MS.length) stop();
+        return true;
+    }
+}
diff --git a/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java
new file mode 100644
--- /dev/null
+++ b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicy.java
@@ -0,0 +1,128 @@
+package com.fongmi.android.tv.ui.activity;
+
+import java.net.URI;
+import java.text.Normalizer;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+final class FamilyRouteProbePolicy {
+    static final int SOURCE_LIMIT = 6;
+    static final int ROUTE_LIMIT = 3;
+    static final int LOCAL_ROUTE_LIMIT = 6;
+    private static final Pattern EPISODE_NUMBER = Pattern.compile("(?:episode|ep\\.?|e|第)?\\s*0*([0-9]{1,4})\\s*(?:集|话|話)?");
+    static final int MIN_ADVANCE_MS = 350;
+
+    enum LocalStatus { PROBE, MANUAL_ONLY, LIMIT_REACHED, NO_MATCH, PLAYABLE, LOGIN_REQUIRED, UNVERIFIED }
+    enum ProbeResult { PLAYABLE, LOGIN_REQUIRED, UNVERIFIED }
+
+    static ProbeResult httpFailure(int responseCode) {
+        return responseCode == 401 ? ProbeResult.LOGIN_REQUIRED : ProbeResult.UNVERIFIED;
+    }
+
+    static LocalStatus localResult(ProbeResult result) {
+        return switch (result) {
+            case PLAYABLE -> LocalStatus.PLAYABLE;
+            case LOGIN_REQUIRED -> LocalStatus.LOGIN_REQUIRED;
+            case UNVERIFIED -> LocalStatus.UNVERIFIED;
+        };
+    }
+
+    static LocalStatus localStatus(boolean matched, boolean plain, String url, int scheduled) {
+        if (!matched) return LocalStatus.NO_MATCH;
+        if (!plain || !directMedia(url)) return LocalStatus.MANUAL_ONLY;
+        return scheduled < LOCAL_ROUTE_LIMIT ? LocalStatus.PROBE : LocalStatus.LIMIT_REACHED;
+    }
+
+    static boolean canSelect(LocalStatus status) {
+        return status == LocalStatus.PLAYABLE || status == LocalStatus.MANUAL_ONLY
+                || status == LocalStatus.LIMIT_REACHED || status == LocalStatus.UNVERIFIED
+                || status == LocalStatus.LOGIN_REQUIRED;
+    }
+
+    static String identity(String site, String id) {
+        return site.length() + ":" + site + id;
+    }
+
+    // Match labels, never a playlist position: lists can omit episodes or be reversed.
+    static int episodeIndex(String current, List<String> alternatives) {
+        String label = normalize(current);
+        if (label.isEmpty()) return -1;
+        int exact = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (!label.equals(normalize(alternatives.get(i)))) continue;
+            if (exact != -1) return -1;
+            exact = i;
+        }
+        if (exact != -1) return exact;
+        int number = episodeNumber(label);
+        if (number < 0) return -1;
+        int match = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (number != episodeNumber(normalize(alternatives.get(i)))) continue;
+            if (match != -1) return -1;
+            match = i;
+        }
+        return match;
+    }
+
+    // Scan by episode identity, not display order: a playable trailer can be listed first.
+    static int initialEpisodeIndex(List<String> labels) {
+        int episodeOne = -1;
+        int fullFeature = -1;
+        boolean numbered = false;
+        for (int i = 0; i < labels.size(); i++) {
+            String label = normalize(labels.get(i));
+            int number = episodeNumber(label);
+            if (number >= 0) numbered = true;
+            if (number == 1) {
+                if (episodeOne >= 0) return -1;
+                episodeOne = i;
+            }
+            if (label.equals("正片") || label.equals("全片") || label.equals("full movie")
+                    || label.equals("full feature")) {
+                fullFeature = fullFeature == -1 ? i : -2;
+            }
+        }
+        return episodeOne >= 0 || numbered ? episodeOne : Math.max(fullFeature, -1);
+    }
+
+    private static String normalize(String label) {
+        return label == null ? "" : Normalizer.normalize(label, Normalizer.Form.NFKC).trim().toLowerCase(Locale.ROOT);
+    }
+
+    private static int episodeNumber(String label) {
+        var match = EPISODE_NUMBER.matcher(label);
+        return match.matches() ? Integer.parseInt(match.group(1)) : -1;
+    }
+
+    static boolean directMedia(String raw) {
+        if (raw == null || raw.length() > 4096) return false;
+        try {
+            URI url = URI.create(raw);
+            String scheme = url.getScheme();
+            String path = url.getPath();
+            return ("https".equalsIgnoreCase(scheme) || "http".equalsIgnoreCase(scheme))
+                    && url.getHost() != null && url.getUserInfo() == null && path != null
+                    && path.toLowerCase(Locale.ROOT).matches(".*[.](mp4|m4v|webm|mkv|m3u8|mpd|ts)$");
+        } catch (IllegalArgumentException ignored) {
+            return false;
+        }
+    }
+
+    // Only explicit permanent media removal may trigger unattended retries.
+    // Timeouts, access errors and ambiguous parsing never qualify.
+    static boolean canAutoRetry(boolean mediaGone, String activeUrl, int type,
+                                boolean hasExtension, boolean hasHeaders, boolean hasPlayUrl) {
+        return mediaGone && plainCatalog(type, hasExtension, hasHeaders, hasPlayUrl) && directMedia(activeUrl);
+    }
+
+    static boolean plainCatalog(int type, boolean hasExtension, boolean hasHeaders, boolean hasPlayUrl) {
+        return (type == 0 || type == 1) && !hasExtension && !hasHeaders && !hasPlayUrl;
+    }
+
+    static boolean confirmed(boolean firstFrame, long firstPositionMs, long currentPositionMs) {
+        return firstFrame && currentPositionMs >= firstPositionMs
+                && currentPositionMs - firstPositionMs >= MIN_ADVANCE_MS;
+    }
+}
