+    private static String normalize(String label) {
+        return label == null ? "" : Normalizer.normalize(label, Normalizer.Form.NFKC).trim().toLowerCase(Locale.ROOT);
+    }
+
+    private static int episodeNumber(String label) {
+        var match = EPISODE_NUMBER.matcher(label);
+        if (match.matches()) return Integer.parseInt(match.group(1));
+        var chinese = CHINESE_EPISODE.matcher(label);
+        if (!chinese.matches()) return -1;
+        String number = chinese.group(1);
+        int ten = number.indexOf('十');
+        if (ten < 0) return number.length() == 1 ? digit(number.charAt(0)) : -1;
+        if (ten > 1 || number.length() - ten > 2 || number.lastIndexOf('十') != ten) return -1;
+        int prefix = ten == 0 ? 1 : digit(number.charAt(0));
+        int suffix = number.length() == ten + 1 ? 0 : digit(number.charAt(ten + 1));
+        return prefix > 0 && (number.length() == ten + 1 || suffix > 0) ? prefix * 10 + suffix : -1;
+    }
+
+    private static int digit(char value) {
+        if (value == '两' || value == '兩') return 2;
+        if (value == '〇') return 0;
+        return "零一二三四五六七八九".indexOf(value);
+    }
+
+    static boolean supportsProbe(int type, boolean hasPlayUrl) {
+        return !hasPlayUrl && (type == 0 || type == 1 || type == 4);
+    }
+
+    static boolean canRequest(int type, String value) {
+        return type == 4 ? value != null && !value.isBlank() && value.length() <= 4096 : directMedia(value);
+    }
+
+    static boolean httpMedia(String raw) {
+        return mediaUri(raw) != null;
+    }
+
+    private static URI mediaUri(String raw) {
+        if (raw == null || raw.length() > 4096) return null;
+        try {
+            URI url = URI.create(raw);
+            String scheme = url.getScheme();
+            return ("https".equalsIgnoreCase(scheme) || "http".equalsIgnoreCase(scheme))
+                    && url.getHost() != null && url.getUserInfo() == null ? url : null;
+        } catch (IllegalArgumentException ignored) {
+            return null;
+        }
+    }
+
+    static boolean directMedia(String raw) {
+        URI url = mediaUri(raw);
+        return url != null && url.getPath() != null
+                && url.getPath().toLowerCase(Locale.ROOT).matches(".*[.](mp4|m4v|webm|mkv|m3u8|mpd|ts)$");
+    }
+
+    // Only explicit permanent media removal may trigger unattended retries.
+    // Timeouts, access errors and ambiguous parsing never qualify.
+    static boolean canAutoRetry(boolean mediaGone, String activeUrl, int type,
+                                boolean hasExtension, boolean hasHeaders, boolean hasPlayUrl) {
+        return mediaGone && plainCatalog(type, hasExtension, hasHeaders, hasPlayUrl) && directMedia(activeUrl);
+    }
+
+    static boolean plainCatalog(int type, boolean hasExtension, boolean hasHeaders, boolean hasPlayUrl) {
+        return (type == 0 || type == 1) && !hasExtension && !hasHeaders && !hasPlayUrl;
+    }
+
+    static boolean confirmed(boolean firstFrame, long firstPositionMs, long currentPositionMs) {
+        return firstFrame && currentPositionMs >= firstPositionMs
+                && currentPositionMs - firstPositionMs >= MIN_ADVANCE_MS;
+    }
+}
