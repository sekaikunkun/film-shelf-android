@@ -0,0 +1,79 @@
+package com.fongmi.android.tv.ui.filmshelf
+
+import android.util.LruCache
+import com.fongmi.android.tv.BuildConfig
+import com.github.catvod.net.OkHttp
+import org.json.JSONObject
+import java.net.URLEncoder
+
+/**
+ * Optional TMDB artwork lookup for the Home hero. Disabled unless a token is
+ * built in (`tmdbToken` in local.properties or FILM_SHELF_TMDB_TOKEN). Only the
+ * title is sent; results, including misses, are cached for the process.
+ */
+internal object FilmShelfTmdb {
+    data class Art(val backdrop: String?, val overview: String?, val rating: String?, val year: String?)
+
+    private const val API = "https://api.themoviedb.org/3/search/multi"
+    private const val IMAGE = "https://image.tmdb.org/t/p/w1280"
+    private val MISS = Art(null, null, null, null)
+    private val cache = LruCache<String, Art>(256)
+    private val seasonSuffix = Regex("""\s*(第[一二三四五六七八九十0-9]+[季部]|[Ss]eason\s*\d+|[Ss]\d{1,2}|\(\d{4}\)|（\d{4}）|[\[【].*?[\]】])\s*$""")
+
+    private val token: String get() = BuildConfig.TMDB_TOKEN
+
+    val enabled: Boolean get() = token.isNotBlank()
+
+    fun cached(title: String, year: String?): Art? = cache.get(key(title, year))?.takeIf { it !== MISS }
+
+    /** Blocking; call off the main thread. */
+    fun lookup(title: String, year: String?): Art? {
+        if (!enabled || title.isBlank()) return null
+        val key = key(title, year)
+        cache.get(key)?.let { return it.takeIf { art -> art !== MISS } }
+        val clean = seasonSuffix.replace(title.trim(), "").trim()
+        val art = search(title.trim(), year) ?: clean.takeIf { it.isNotEmpty() && it != title.trim() }?.let { search(it, year) }
+        cache.put(key, art ?: MISS)
+        return art
+    }
+
+    private fun key(title: String, year: String?) = "${title.trim()}|${year.orEmpty()}"
+
+    private fun search(query: String, year: String?): Art? = try {
+        val bearer = token.startsWith("eyJ")
+        val url = buildString {
+            append(API).append("?language=zh-CN&include_adult=false&query=")
+            append(URLEncoder.encode(query, "UTF-8"))
+            if (!bearer) append("&api_key=").append(URLEncoder.encode(token, "UTF-8"))
+        }
+        val headers = if (bearer) mapOf("Authorization" to "Bearer $token", "Accept" to "application/json")
+            else mapOf("Accept" to "application/json")
+        OkHttp.newCall(url, headers).execute().use { response ->
+            if (!response.isSuccessful) null else pick(JSONObject(response.body.string()), year)
+        }
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun pick(json: JSONObject, year: String?): Art? {
+        val results = json.optJSONArray("results") ?: return null
+        var fallback: Art? = null
+        for (i in 0 until results.length()) {
+            val item = results.optJSONObject(i) ?: continue
+            val type = item.optString("media_type")
+            if (type != "movie" && type != "tv") continue
+            val path = item.optString("backdrop_path").takeIf { it.startsWith("/") } ?: continue
+            val date = item.optString(if (type == "movie") "release_date" else "first_air_date")
+            val vote = item.optDouble("vote_average", 0.0)
+            val art = Art(
+                backdrop = IMAGE + path,
+                overview = item.optString("overview").takeIf { it.isNotBlank() },
+                rating = if (vote > 0) String.format("%.1f", vote) else null,
+                year = date.take(4).takeIf { it.length == 4 },
+            )
+            if (year.isNullOrBlank() || art.year == year.trim().take(4)) return art
+            if (fallback == null) fallback = art
+        }
+        return fallback
+    }
+}
