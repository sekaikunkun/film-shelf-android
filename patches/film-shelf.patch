+    static final int MIN_ADVANCE_MS = 350;
+
+    enum LocalStatus { PROBE, MANUAL_ONLY, LIMIT_REACHED, NO_MATCH, PLAYABLE, LOGIN_REQUIRED, UNVERIFIED }
