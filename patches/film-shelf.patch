@@ -0,0 +1,39 @@
+package com.fongmi.android.tv.bean;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+/** A detail response is not guaranteed to contain only the requested title. */
+public final class DetailIdentity {
+    private DetailIdentity() {}
+
+    public static <T> Map<String, T> indexUnique(List<T> rows, Function<T, String> idOf) {
+        Map<String, T> result = new HashMap<>();
+        Set<String> ambiguous = new HashSet<>();
+        for (T row : rows) {
+            if (row == null) continue;
+            String id = idOf.apply(row);
+            if (id == null || id.isBlank() || ambiguous.contains(id)) continue;
+            if (result.putIfAbsent(id, row) != null) {
+                result.remove(id);
+                ambiguous.add(id);
+            }
+        }
+        return result;
+    }
+
+    public static <T> T find(String requested, List<T> rows, Function<T, String> idOf) {
+        if (requested == null || requested.isBlank()) return null;
+        T match = null;
+        for (T row : rows) {
+            if (row == null || !requested.equals(idOf.apply(row))) continue;
+            if (match != null) return null;
+            match = row;
+        }
+        return match;
+    }
+}
diff --git a/app/src/main/java/com/fongmi/android/tv/db/dao/ConfigDao.java b/app/src/main/java/com/fongmi/android/tv/db/dao/ConfigDao.java
