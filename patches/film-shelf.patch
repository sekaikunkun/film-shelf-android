diff --git a/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyScanProgress.java b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyScanProgress.java
new file mode 100644
index 0000000..2198117
--- /dev/null
+++ b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyScanProgress.java
@@ -0,0 +1,78 @@
+package com.fongmi.android.tv.ui.activity;
+
+import android.animation.ObjectAnimator;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.os.Build;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.animation.AccelerateDecelerateInterpolator;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+
+import com.fongmi.android.tv.R;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.google.android.material.progressindicator.LinearProgressIndicator;
+
+/** Reflects work reported by the scanner. The decorative disc never drives progress. */
+final class FamilyScanProgress {
+    private final Context context;
+    private final AlertDialog dialog;
+    private final TextView current;
+    private final TextView completed;
+    private final LinearProgressIndicator bar;
+    private final View disc;
+    private final boolean cross;
+    private ObjectAnimator flip;
+    private int lastDone = -1;
+
+    FamilyScanProgress(Context context, String title, boolean cross, Runnable cancel) {
+        this.context = context;
+        this.cross = cross;
+        View panel = LayoutInflater.from(context).inflate(R.layout.dialog_family_scan_progress, null);
+        current = panel.findViewById(R.id.family_scan_current);
+        completed = panel.findViewById(R.id.family_scan_completed);
+        bar = panel.findViewById(R.id.family_scan_bar);
+        disc = panel.findViewById(R.id.family_scan_disc);
+        disc.setCameraDistance(1600 * context.getResources().getDisplayMetrics().density);
+        current.setText(R.string.family_scan_preparing);
+        dialog = new MaterialAlertDialogBuilder(context)
+                .setTitle(title).setView(panel)
+                .setNegativeButton(R.string.family_scan_cancel, (unused, which) -> cancel.run())
+                .setOnCancelListener(unused -> cancel.run())
+                .create();
+        dialog.setCanceledOnTouchOutside(false);
+    }
+
+    AlertDialog dialog() {
+        return dialog;
+    }
+
+    void update(int done, int total, String label) {
+        if (total <= 0 || done < 0 || done >= total || done < lastDone) return;
+        current.setText(context.getString(cross ? R.string.family_scan_source_current
+                : R.string.family_scan_line_current, done + 1, total));
+        completed.setText(context.getString(R.string.family_scan_completed, done, total,
+                label == null || label.isBlank() ? context.getString(R.string.family_scan_unnamed) : label));
+        bar.setMax(total);
+        boolean motion = Build.VERSION.SDK_INT < 26 || ValueAnimator.areAnimatorsEnabled();
+        bar.setProgressCompat(done, motion && lastDone >= 0);
+        if (done != lastDone) {
+            lastDone = done;
+            if (motion) {
+                stopAnimation();
+                flip = ObjectAnimator.ofFloat(disc, View.ROTATION_Y, -68f, 0f);
+                flip.setDuration(230);
+                flip.setInterpolator(new AccelerateDecelerateInterpolator());
+                flip.start();
+            }
+        }
+    }
+
+    void stopAnimation() {
+        if (flip != null) flip.cancel();
+        flip = null;
+        disc.setRotationY(0f);
+    }
+}
