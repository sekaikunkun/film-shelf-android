index 0000000000000000000000000000000000000000..d556ac02fe1dbafc67b7529b4c22c11dcf4d66b8
--- /dev/null
+++ b/app/src/leanback/java/com/fongmi/android/tv/ui/activity/FamilyDirectRouteScan.java
@@ -0,0 +1,247 @@
+package com.fongmi.android.tv.ui.activity;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.media3.common.C;
+import androidx.media3.common.MediaItem;
+import androidx.media3.common.PlaybackException;
+import androidx.media3.common.Player;
+import androidx.media3.common.util.UnstableApi;
+import androidx.media3.datasource.DefaultHttpDataSource;
+import androidx.media3.exoplayer.ExoPlayer;
+import androidx.media3.exoplayer.source.DefaultMediaSourceFactory;
+import androidx.media3.exoplayer.video.PlaceholderSurface;
+
+import com.fongmi.android.tv.bean.Episode;
+import com.fongmi.android.tv.bean.Flag;
+import com.fongmi.android.tv.bean.Result;
+import com.fongmi.android.tv.bean.Site;
+import com.fongmi.android.tv.bean.Vod;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.Call;
+import okhttp3.HttpUrl;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okio.BufferedSource;
+
+@UnstableApi
+final class FamilyDirectRouteScan {
+    private static final long DETAIL_BYTES = 512 * 1024;
+    private static final long ROUTE_MILLIS = 6500;
+    record Candidate(Vod vod, Site site) {}
+    record Route(String flag, String episode, String url) {}
+    record Outcome(Candidate candidate, Route playable, boolean attempted) {}
+    interface Listener {
+        void progress(int done, int total, String source);
+        void complete(List<Outcome> outcomes);
+    }
+
+    record LocalOutcome(Route route, boolean playable) {}
+    interface LocalListener {
+        void progress(int done, int total, String route);
+        void complete(List<LocalOutcome> outcomes);
+    }
+
+    private final Context context;
+    private final List<Candidate> sources;
+    private final Listener listener;
+    private final LocalListener local;
+    private final List<LocalOutcome> localOutcomes = new ArrayList<>();
+    private final List<Outcome> outcomes = new ArrayList<>();
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final OkHttpClient http = new OkHttpClient.Builder()
+            .callTimeout(4000, TimeUnit.MILLISECONDS).followRedirects(false).build();
+    private int sourceIndex, routeIndex, probeVersion;
+    private List<Route> routes = Collections.emptyList();
+    private boolean active = true;
+    private volatile Call call;
+    private ExoPlayer probe;
+    private PlaceholderSurface surface;
+    private boolean rendered;
+    private long positionAtFrame;
+    private final Runnable sample = this::sampleProgress;
+    private Runnable timeout;
+
+    FamilyDirectRouteScan(Context context, List<Candidate> sources, Listener listener) {
+        this.context = context.getApplicationContext();
+        this.sources = List.copyOf(sources);
+        this.listener = listener;
+        this.local = null;
+    }
+
+    FamilyDirectRouteScan(Context context, List<Route> routes, LocalListener listener) {
+        this.context = context.getApplicationContext();
+        this.sources = Collections.emptyList();
+        this.listener = null;
+        this.local = listener;
+        this.routes = List.copyOf(routes);
+    }
+
+    void start() {
+        if (local == null) nextSource();
+        else nextRoute();
+    }
+
+    private void finishRoute(boolean playable) {
+        if (local == null) {
+            if (playable) finishSource(routes.get(routeIndex - 1), true);
+            else nextRoute();
+        } else {
+            localOutcomes.add(new LocalOutcome(routes.get(routeIndex - 1), playable));
+            nextRoute();
+        }
+    }
+
+    void close() {
+        if (!active) return;
+        active = false;
+        Call current = call;
+        if (current != null) current.cancel();
+        worker.shutdownNow();
+        http.connectionPool().evictAll();
+        stopProbe();
+    }
+
+    private void nextSource() {
+        if (!active) return;
+        if (sourceIndex == sources.size()) {
+            close();
+            listener.complete(List.copyOf(outcomes));
+            return;
+        }
+        Candidate c = sources.get(sourceIndex);
+        listener.progress(sourceIndex, sources.size(), c.vod().getSiteName());
+        worker.execute(() -> {
+            List<Route> result;
+            try { result = loadRoutes(c); }
+            catch (IOException | RuntimeException ignored) { result = Collections.emptyList(); }
+            final List<Route> delivered = result;
+            main.post(() -> {
+                if (!active) return;
+                routes = delivered;
+                routeIndex = 0;
+                if (routes.isEmpty()) finishSource(null, false);
+                else nextRoute();
+            });
+        });
+    }
+
+    private List<Route> loadRoutes(Candidate candidate) throws IOException {
+        Site site = candidate.site();
+        int type = site.getType();
+        if (!FamilyRouteProbePolicy.plainCatalog(type, !site.getExt().isEmpty(), !site.getHeader().isEmpty()))
+            return Collections.emptyList();
+        HttpUrl api = HttpUrl.parse(site.getApi());
+        if (api == null || !api.username().isEmpty() || !api.password().isEmpty())
+            return Collections.emptyList();
+        HttpUrl url = api.newBuilder().setQueryParameter("ac", type == 0 ? "videolist" : "detail")
+                .setQueryParameter("ids", candidate.vod().getId()).build();
+        Call request = http.newCall(new Request.Builder().url(url).build());
+        call = request;
+        if (worker.isShutdown()) { request.cancel(); return Collections.emptyList(); }
+        try (Response response = request.execute()) {
+            if (!response.isSuccessful()) return Collections.emptyList();
+            BufferedSource body = response.body().source();
+            if (body.request(DETAIL_BYTES + 1)) return Collections.emptyList();
+            Result result = Result.fromType(type, body.readUtf8());
+            List<Route> found = new ArrayList<>();
+            for (Flag flag : result.getVod().setFlags().getFlags()) {
+                if (flag.getEpisodes().isEmpty()) continue;
+                Episode first = flag.getEpisodes().get(0);
+                if (FamilyRouteProbePolicy.directMedia(first.getUrl())) {
+                    found.add(new Route(flag.getFlag(), first.getName(), first.getUrl()));
+                    if (found.size() == FamilyRouteProbePolicy.ROUTE_LIMIT) break;
+                }
+            }
+            return found;
+        } finally {
+            call = null;
+        }
+    }
+
+    private void nextRoute() {
+        if (!active) return;
+        stopProbe();
+        if (routeIndex == routes.size()) {
+            if (local == null) finishSource(null, true);
+            else {
+                close();
+                local.complete(List.copyOf(localOutcomes));
+            }
+            return;
+        }
+        Route route = routes.get(routeIndex++);
+        if (local != null) local.progress(routeIndex - 1, routes.size(), route.flag());
+        int version = ++probeVersion;
+        try {
+            surface = PlaceholderSurface.newInstance(context, false);
+            DefaultHttpDataSource.Factory data = new DefaultHttpDataSource.Factory()
+                    .setConnectTimeoutMs(3500).setReadTimeoutMs(3500);
+            probe = new ExoPlayer.Builder(context)
+                    .setMediaSourceFactory(new DefaultMediaSourceFactory(data)).build();
+            probe.setTrackSelectionParameters(probe.getTrackSelectionParameters().buildUpon()
+                    .setTrackTypeDisabled(C.TRACK_TYPE_AUDIO, true).setTrackTypeDisabled(C.TRACK_TYPE_TEXT, true).build());
+            probe.setVolume(0f);
+            probe.addListener(new Player.Listener() {
+                @Override public void onRenderedFirstFrame() {
+                    if (!active || probe == null || version != probeVersion || rendered) return;
+                    rendered = true;
+                    positionAtFrame = probe.getCurrentPosition();
+                    main.postDelayed(sample, 150);
+                }
+                @Override public void onPlayerError(PlaybackException error) {
+                    if (active && version == probeVersion) main.post(() -> {
+                        if (active && version == probeVersion) finishRoute(false);
+                    });
+                }
+            });
+            probe.setVideoSurface(surface);
+            probe.setMediaItem(MediaItem.fromUri(route.url()));
+            probe.prepare();
+            probe.play();
+            timeout = () -> { if (active && version == probeVersion) finishRoute(false); };
+            main.postDelayed(timeout, ROUTE_MILLIS);
+        } catch (RuntimeException ignored) {
+            main.post(() -> { if (active && version == probeVersion) finishRoute(false); });
+        }
+    }
+
+    private void sampleProgress() {
+        if (!active || probe == null || !rendered) return;
+        if (FamilyRouteProbePolicy.confirmed(true, positionAtFrame, probe.getCurrentPosition()))
+            finishRoute(true);
+        else main.postDelayed(sample, 150);
+    }
+
+    private void stopProbe() {
+        ++probeVersion;
+        main.removeCallbacks(sample);
+        if (timeout != null) main.removeCallbacks(timeout);
+        timeout = null;
+        rendered = false;
+        ExoPlayer current = probe;
+        probe = null;
+        if (current != null) current.release();
+        PlaceholderSurface currentSurface = surface;
+        surface = null;
+        if (currentSurface != null) currentSurface.release();
+    }
+
+    private void finishSource(Route playable, boolean tried) {
+        stopProbe();
+        outcomes.add(new Outcome(sources.get(sourceIndex++), playable, tried));
+        nextSource();
+    }
+}
