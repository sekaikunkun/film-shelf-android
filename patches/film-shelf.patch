+import androidx.tv.material3.Text
+import com.bumptech.glide.Glide
+import com.bumptech.glide.load.resource.drawable.DrawableTransitionOptions
+import com.fongmi.android.tv.R
+import com.fongmi.android.tv.utils.ImgUtil
+import com.fongmi.android.tv.utils.PosterPlaceholder
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+
+/**
+ * Netflix-style billboard behind the native Home rows: the focused title's
+ * backdrop with edge scrims, and its title, facts and synopsis top-left.
+ * Presentation only; the Activity tells it which item is focused.
+ */
+object FilmShelfHero {
+
+    /** Immutable description of what the billboard shows. */
+    class Item @JvmOverloads constructor(
+        val key: String,
+        val title: String,
+        val year: String? = null,
+        val facts: List<String> = emptyList(),
+        val badge: String? = null,
+        val overview: String? = null,
+        val poster: String? = null,
+        val backdrop: String? = null,
+    )
+
+    class Controller internal constructor() {
+        internal var item by mutableStateOf<Item?>(null)
+        internal var topInset by mutableIntStateOf(0)
+
+        val key: String? get() = item?.key
+
+        fun show(next: Item?) {
+            if (next?.key == item?.key && next?.title == item?.title) return
+            item = next
+        }
+
+        /** Space, in px, taken by the chrome above the billboard text. */
+        fun setTopInset(px: Int) { topInset = px }
+    }
+
+    @JvmStatic
+    fun attach(parent: ViewGroup): Controller {
+        val controller = Controller()
+        val view = ComposeView(parent.context).apply {
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+            layoutParams = ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
+            isFocusable = false
+        }
+        view.setContent { FilmShelfTheme { Billboard(controller) } }
+        parent.addView(view)
+        return controller
+    }
+}
+
+private data class Resolved(
+    val item: FilmShelfHero.Item,
+    val image: String?,
+    val sharp: Boolean,
+    val overview: String?,
+    val rating: String?,
+)
+
+private fun resolve(item: FilmShelfHero.Item, art: FilmShelfTmdb.Art?): Resolved {
+    val backdrop = item.backdrop?.takeIf { it.isNotBlank() } ?: art?.backdrop
+    return Resolved(
+        item = item,
+        image = backdrop ?: item.poster?.takeIf { it.isNotBlank() },
+        sharp = backdrop != null,
+        overview = item.overview?.takeIf { it.isNotBlank() } ?: art?.overview,
+        rating = art?.rating,
+    )
+}
+
+@Composable
+private fun Billboard(controller: FilmShelfHero.Controller) {
+    val background = colorResource(R.color.film_shelf_home_background)
+    val item = controller.item
+    var resolved by androidx.compose.runtime.remember { mutableStateOf<Resolved?>(null) }
+
+    LaunchedEffect(item?.key, item?.title) {
+        if (item == null) { resolved = null; return@LaunchedEffect }
+        val cached = FilmShelfTmdb.cached(item.title, item.year)
+        resolved = resolve(item, cached)
+        if (cached != null || !item.backdrop.isNullOrBlank() || !FilmShelfTmdb.enabled) return@LaunchedEffect
+        // Wait for focus to settle so D-pad scrubbing through a row costs no requests.
+        delay(450)
+        val art = withContext(Dispatchers.IO) { FilmShelfTmdb.lookup(item.title, item.year) } ?: return@LaunchedEffect
+        resolved = resolve(item, art)
+    }
+
+    Box(Modifier.fillMaxSize().background(background)) {
+        Backdrop(resolved, background)
+        Box(Modifier.fillMaxSize().background(Brush.horizontalGradient(
+            0f to background, 0.32f to background.copy(alpha = 0.86f), 0.62f to background.copy(alpha = 0.18f), 1f to Color.Transparent,
+        )))
+        Box(Modifier.fillMaxSize().background(Brush.verticalGradient(
+            0f to background.copy(alpha = 0.55f), 0.18f to Color.Transparent, 0.42f to Color.Transparent, 0.66f to background,
+        )))
+        BoxWithConstraints(Modifier.fillMaxSize()) {
+            val top: Dp = with(androidx.compose.ui.platform.LocalDensity.current) { controller.topInset.toDp() }
+            AnimatedContent(
+                targetState = resolved,
+                transitionSpec = { fadeIn(tween(260)) togetherWith fadeOut(tween(160)) },
+                contentKey = { it?.item?.key to it?.overview },
+                label = "hero",
+            ) { state ->
+                if (state != null) Info(state, Modifier.padding(start = 48.dp, top = top + 4.dp).width(maxWidth * 0.46f))
+            }
+        }
+    }
+}
+
+@Composable
+private fun Backdrop(state: Resolved?, background: Color) {
+    val tint = android.graphics.Color.argb(255, (background.red * 255).toInt(), (background.green * 255).toInt(), (background.blue * 255).toInt())
+    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.TopEnd) {
+        AndroidView(
+            modifier = Modifier.fillMaxWidth(0.78f).fillMaxHeight(0.76f),
+            factory = { context ->
+                ImageView(context).apply {
+                    scaleType = ImageView.ScaleType.CENTER_CROP
+                    isFocusable = false
+                    setImageDrawable(ColorDrawable(tint))
+                }
+            },
+            update = { view -> load(view, state) },
+        )
+    }
+}
+
+private fun load(view: ImageView, state: Resolved?) {
+    val tag = state?.let { "${it.item.key}|${it.image}|${it.sharp}" }
+    if (view.tag == tag) return
+    view.tag = tag
+    if (state == null) return
+    val fallback: Drawable = PosterPlaceholder(state.item.title, false)
+    val url = state.image?.let { ImgUtil.getUrl(it) }
+    if (url == null) {
+        Glide.with(view).clear(view)
+        view.setImageDrawable(fallback)
+        view.alpha = 0.9f
+        return
+    }
+    view.alpha = if (state.sharp) 1f else 0.55f
+    val request = Glide.with(view).load(url)
+        .placeholder(view.drawable ?: fallback)
+        .error(fallback)
+        .transition(DrawableTransitionOptions.withCrossFade(420))
+        .centerCrop()
+    // Posters are portrait and often low-res: a tiny decode upscaled by the
+    // ImageView reads as a soft colour field instead of a blurry crop.
+    if (state.sharp) request.into(view) else request.override(48, 27).into(view)
+}
+
+@Composable
+private fun Info(state: Resolved, modifier: Modifier) {
+    val ink = colorResource(R.color.film_flow_ink)
+    val muted = colorResource(R.color.film_flow_muted)
+    val accent = colorResource(R.color.film_flow_accent)
+    Column(modifier, verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(
+            state.item.title,
+            color = ink,
+            fontSize = if (state.item.title.length > 12) 30.sp else 38.sp,
+            fontWeight = FontWeight.Bold,
+            lineHeight = 42.sp,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+        )
+        val facts = buildList {
+            state.rating?.let { add("★ $it") }
+            state.item.year?.takeIf { it.isNotBlank() }?.let { add(it.trim()) }
+            addAll(state.item.facts.filter { it.isNotBlank() }.map { it.trim() })
+        }.distinct()
+        if (facts.isNotEmpty() || !state.item.badge.isNullOrBlank()) {
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                state.item.badge?.takeIf { it.isNotBlank() }?.let {
+                    Text(
+                        it,
+                        color = accent,
+                        style = MaterialTheme.typography.labelMedium,
+                        fontWeight = FontWeight.SemiBold,
+                        maxLines = 1,
+                        modifier = Modifier
+                            .border(1.dp, accent.copy(alpha = 0.7f), RoundedCornerShape(6.dp))
+                            .padding(horizontal = 7.dp, vertical = 2.dp),
+                    )
+                }
+                Text(
+                    facts.joinToString("  ·  "),
+                    color = muted,
+                    style = MaterialTheme.typography.bodyMedium,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+        state.overview?.let {
+            Text(
+                it.replace(Regex("\\s+"), " ").trim(),
+                color = ink.copy(alpha = 0.82f),
+                style = MaterialTheme.typography.bodyMedium,
+                lineHeight = 21.sp,
+                maxLines = 3,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
