+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("Trailer", "Season 2 Episode 1")));
+    }
+    @Test public void onlyExplicitAuthenticationResponseIsLabeledLoginRequired() {
+        for (int code : new int[]{0, 200, 403, 404, 408, 429, 500}) {
+            assertEquals(FamilyRouteProbePolicy.ProbeResult.UNVERIFIED, FamilyRouteProbePolicy.httpFailure(code));
+        }
+        assertEquals(FamilyRouteProbePolicy.ProbeResult.LOGIN_REQUIRED, FamilyRouteProbePolicy.httpFailure(401));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.LOGIN_REQUIRED,
+                FamilyRouteProbePolicy.localResult(FamilyRouteProbePolicy.ProbeResult.LOGIN_REQUIRED));
+        assertTrue(FamilyRouteProbePolicy.canSelect(FamilyRouteProbePolicy.LocalStatus.LOGIN_REQUIRED));
+    }
+}
