+        cancelFamilyScan();
+        AlertDialog progress = new MaterialAlertDialogBuilder(this)
+                .setTitle("检测本集线路 · " + episodeName)
+                .setMessage("准备检测…")
+                .setNegativeButton("取消", null).create();
+        familyScanDialog = progress;
+        progress.setOnDismissListener(dismissed -> {
+            if (familyScanDialog == progress) cancelFamilyScan();
+        });
+        familyScan = new FamilyDirectRouteScan(this, routes, new FamilyDirectRouteScan.LocalListener() {
+            @Override public void progress(int done, int total, String route) {
+                if (familyScanDialog == progress)
