@@ -0,0 +1,160 @@
+package com.fongmi.android.tv.ui.activity;
+
+import java.net.URI;
+import java.text.Normalizer;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+final class FamilyRouteProbePolicy {
+    static final int SOURCE_LIMIT = 6;
+    static final int ROUTE_LIMIT = 3;
+    static final int LOCAL_ROUTE_LIMIT = 6;
+    private static final Pattern EPISODE_NUMBER = Pattern.compile("(?:episode|ep\\.?|e|第)?\\s*0*([0-9]{1,4})\\s*(?:集|话|話)?");
