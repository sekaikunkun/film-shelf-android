diff --git a/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..58e501505e76a9b3fd37904671c59199cafcab7d
--- /dev/null
+++ b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java
@@ -0,0 +1,46 @@
+package com.fongmi.android.tv.ui.activity;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class FamilyPlaybackWaitPolicyTest {
+    @Test public void explicitLoginChallengesAreNotPlaybackFailures() {
+        for (String s : new String[]{"请打开客户端扫码登录", "請登入", "需会员登录", "扫码超时",
+                "二维码已过期", "登录已过期", "SCAN QR CODE now", "Sign-in required", "Please log in"}) {
+            assertEquals(s, FamilyPlaybackWait.Failure.LOGIN, FamilyPlaybackWait.classifyFailure(s));
+        }
+    }
+
+    @Test public void absenceOfLoginOrGenericTimeoutDoesNotLookLikeAChallenge() {
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("网络连接超时"));
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("HTTP timed out"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("本线路无需扫码登录，网络错误"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("QR artwork load failed"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("HTTP 404"));
+    }
+
+    @Test public void focusedWaitStartsFreshWhenCoveredPastDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(9_999, false));
+        assertFalse(wait.shouldPrompt(10_000, true));
+        assertFalse(wait.shouldPrompt(120_000, true));
+        assertFalse(wait.shouldPrompt(140_000, false));
+        assertFalse(wait.shouldPrompt(149_999, false));
+        assertTrue(wait.shouldPrompt(150_000, false));
+        assertTrue(wait.shouldPrompt(170_000, false));
+        assertFalse(wait.shouldPrompt(171_000, false));
+    }
+
+    @Test public void stopAndStartClearsOldOverlayAndDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(100_000, true));
+        wait.stop();
+        assertFalse(wait.shouldPrompt(120_000, false));
+        wait.start(200_000);
+        assertFalse(wait.shouldPrompt(209_999, false));
+        assertTrue(wait.shouldPrompt(210_000, false));
+    }
+}
diff --git a/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..dc83b327cac4bbccdc9c14455a2c216ff5c47c6f
--- /dev/null
+++ b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java
@@ -0,0 +1,52 @@
+package com.fongmi.android.tv.ui.activity;
+
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class FamilyRouteProbePolicyTest {
+    @Test public void sameIdAtDifferentSuppliersIsNotTheSameMovieIdentity() {
+        assertNotEquals(FamilyRouteProbePolicy.identity("a", "123"), FamilyRouteProbePolicy.identity("b", "123"));
+        assertNotEquals(FamilyRouteProbePolicy.identity("a", "b123"), FamilyRouteProbePolicy.identity("ab", "123"));
+    }
+
+    @Test public void passRequiresFrameAndForwardProgress() {
+        assertFalse(FamilyRouteProbePolicy.confirmed(false, 0, 9999));
+        assertFalse(FamilyRouteProbePolicy.confirmed(true, 100, 449));
+        assertFalse(FamilyRouteProbePolicy.confirmed(true, 100, 30));
+        assertTrue(FamilyRouteProbePolicy.confirmed(true, 100, 450));
+    }
+
+    @Test public void unknownLinksAreNotSilentlyTreatedAsMedia() {
+        assertTrue(FamilyRouteProbePolicy.directMedia("https://example.org/a.MP4?k=1"));
+        assertTrue(FamilyRouteProbePolicy.directMedia("http://127.0.0.1/000.m3u8"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("https://example.org/watch?video=.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("https://user:secret@example.org/a.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("file:///tmp/a.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("magnet:?xt=urn:btih:0"));
+    }
+
+    @Test public void scansCurrentEpisodeInReorderedAndShorterPlaylists() {
+        assertEquals(1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode01", "Episode09", "Episode02")));
+        assertEquals(0, FamilyRouteProbePolicy.episodeIndex("第９集", List.of("EP.09", "第10集")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode01")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("第10集", "第08集")));
+    }
+
+    @Test public void neverGuessesAnAmbiguousEpisodeOrMergesSeasonLabels() {
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("第09集", List.of("Episode 9", "第9话")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode09", "EPISODE09")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "Episode09")));
+        assertEquals(1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "S02E09")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("", List.of("")));
+    }
+
+    @Test public void directChecksRequireCatalogWithoutPluginExtensionOrHeaders() {
+        assertTrue(FamilyRouteProbePolicy.plainCatalog(1, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(3, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(0, true, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(1, false, true));
+    }
+}
