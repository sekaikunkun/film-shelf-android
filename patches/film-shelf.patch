+    private void pollFamilyWait() {
+        if (!familyResumed || isFinishing() || isDestroyed()) return;
+        if (familyDialog != null && familyDialog.isShowing()) {
+            scheduleFamilyTick();
+            return;
+        }
+        boolean obscured = !hasWindowFocus() || familyScanDialog != null || mQuickSearchDialog != null;
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (familyLoginWait) {
+            if (!obscured && familyAuthNotice) {
+                familyAuthNotice = false;
+                showFamilyLogin();
+            }
+        } else if (!obscured && familyError != null) {
+            String error = familyError;
+            boolean expiredBehindOverlay = familyErrorObscured
+                    && FamilyPlaybackWait.classifyFailure(error) == FamilyPlaybackWait.Failure.TIMEOUT;
+            familyError = null;
+            familyErrorObscured = false;
+            if (expiredBehindOverlay) familyWait.start(now);
+            else {
+                applyFamilyFailure(error);
+                if (!tryFamilyNextLine(error)) showFamilyRecovery(FamilyPlaybackWait.classifyFailure(error));
+            }
+        } else if (familyWait.shouldPrompt(now, obscured)) {
+            showFamilyRecovery(null);
+        }
+        scheduleFamilyTick();
+    }
+
+    private boolean tryFamilyNextLine(String error) {
+        if (!PlayerSetting.isAutoChange() || familyLoginWait || familyScanDialog != null
+                || mQuickSearchDialog != null || service() == null || mFlagAdapter.getItemCount() < 2
+                || mEpisodeAdapter.getItemCount() == 0 || mHistory == null) return false;
+        Site site = getSite();
+        if (!site.isChangeable()) return false;
+        Episode active = getEpisode();
+        if (!FamilyRouteProbePolicy.canAutoRetry(
+                getString(R.string.family_media_gone).equals(error), active.getUrl(), site.getType(),
+                !site.getExt().isEmpty(), !site.getHeader().isEmpty(), !site.getPlayUrl().isEmpty())) return false;
+        List<Flag> flags = mFlagAdapter.getItems();
+        int current = flags.indexOf(getFlag());
+        if (current < 0) return false;
+        for (int offset = 1; offset < flags.size(); offset++) {
+            Flag alternative = flags.get((current + offset) % flags.size());
+            if (alternative.isSelected()) continue;
+            List<Episode> episodes = alternative.getEpisodes();
+            int target = FamilyRouteProbePolicy.episodeIndex(familyRecoveryEpisode,
+                    episodes.stream().map(Episode::getName).collect(java.util.stream.Collectors.toList()));
+            if (target < 0) continue;
+            Episode match = episodes.get(target);
+            if (!FamilyRouteProbePolicy.directMedia(match.getUrl()) || !familyTriedUrls.add(match.getUrl())) continue;
+            Notify.show(getString(R.string.play_switch_flag, alternative.getFlag()));
+            familyRetryingLine = true;
+            try {
+                selectFlagEpisode(alternative, match);
+            } finally {
+                familyRetryingLine = false;
+            }
+            return true;
+        }
+        return false;
+    }
