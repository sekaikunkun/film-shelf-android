diff --git a/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyPlaybackWaitPolicyTest.java
@@ -0,0 +1,74 @@
+package com.fongmi.android.tv.ui.activity;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class FamilyPlaybackWaitPolicyTest {
+    @Test public void explicitLoginChallengesAreNotPlaybackFailures() {
+        for (String s : new String[]{"请打开客户端扫码登录", "請登入", "需会员登录", "扫码超时",
+                "二维码已过期", "登录已过期", "SCAN QR CODE now", "Sign-in required", "Please log in"}) {
+            assertEquals(s, FamilyPlaybackWait.Failure.LOGIN, FamilyPlaybackWait.classifyFailure(s));
+        }
+    }
+
+    @Test public void absenceOfLoginOrGenericTimeoutDoesNotLookLikeAChallenge() {
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("网络连接超时"));
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("HTTP timed out"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("本线路无需扫码登录，网络错误"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("QR artwork load failed"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("HTTP 404"));
+    }
+
+    @Test public void unrelatedNegationDoesNotHideExplicitLoginOnThisLine() {
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("不需要扫码登录，网络错误"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("请刷新，登录接口返回错误"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN,
+                FamilyPlaybackWait.classifyFailure("旧版不用扫码登录；当前线路请扫码授权"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN,
+                FamilyPlaybackWait.classifyFailure("Sign-in is not required on the old line. Please log in to use this line"));
+    }
+
+    @Test public void independentQaCoversNegatedAndExpiredQrChallenges() {
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("不需扫码，网络连接超时"));
+        assertEquals(FamilyPlaybackWait.Failure.TIMEOUT, FamilyPlaybackWait.classifyFailure("无需会员登录，网络超时"));
+        assertEquals(FamilyPlaybackWait.Failure.HARD, FamilyPlaybackWait.classifyFailure("No scan QR code required"));
+        assertEquals(FamilyPlaybackWait.Failure.LOGIN, FamilyPlaybackWait.classifyFailure("QR code expired"));
+    }
+
+    @Test public void focusedWaitStartsFreshWhenCoveredPastDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(9_999, false));
+        assertFalse(wait.shouldPrompt(10_000, true));
+        assertFalse(wait.shouldPrompt(120_000, true));
+        assertFalse(wait.shouldPrompt(140_000, false));
+        assertFalse(wait.shouldPrompt(149_999, false));
+        assertTrue(wait.shouldPrompt(150_000, false));
+        assertTrue(wait.shouldPrompt(170_000, false));
+        assertFalse(wait.shouldPrompt(171_000, false));
+    }
+
+    @Test public void rebufferingRearmsAfterReadyWithoutResettingOnDuplicateEvents() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(100);
+        wait.beginIfIdle(5_100);
+        assertTrue(wait.shouldPrompt(10_100, false));
+        wait.stop(); // READY, or successful recovery.
+        wait.beginIfIdle(30_000);
+        assertFalse(wait.shouldPrompt(39_999, false));
+        wait.beginIfIdle(39_999);
+        assertTrue(wait.shouldPrompt(40_000, false));
+    }
+
+    @Test public void stopAndStartClearsOldOverlayAndDeadline() {
+        FamilyPlaybackWait wait = new FamilyPlaybackWait();
+        wait.start(0);
+        assertFalse(wait.shouldPrompt(100_000, true));
+        wait.stop();
+        assertFalse(wait.shouldPrompt(120_000, false));
+        wait.start(200_000);
+        assertFalse(wait.shouldPrompt(209_999, false));
+        assertTrue(wait.shouldPrompt(210_000, false));
+    }
+}
diff --git a/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/fongmi/android/tv/ui/activity/FamilyRouteProbePolicyTest.java
@@ -0,0 +1,125 @@
+package com.fongmi.android.tv.ui.activity;
+
+import com.fongmi.android.tv.bean.DetailIdentity;
+
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class FamilyRouteProbePolicyTest {
+    @Test public void sameIdAtDifferentSuppliersIsNotTheSameMovieIdentity() {
+        assertNotEquals(FamilyRouteProbePolicy.identity("a", "123"), FamilyRouteProbePolicy.identity("b", "123"));
+        assertNotEquals(FamilyRouteProbePolicy.identity("a", "b123"), FamilyRouteProbePolicy.identity("ab", "123"));
+    }
+
+    @Test public void passRequiresFrameAndForwardProgress() {
+        assertFalse(FamilyRouteProbePolicy.confirmed(false, 0, 9999));
+        assertFalse(FamilyRouteProbePolicy.confirmed(true, 100, 449));
+        assertFalse(FamilyRouteProbePolicy.confirmed(true, 100, 30));
+        assertTrue(FamilyRouteProbePolicy.confirmed(true, 100, 450));
+    }
+
+    @Test public void unknownLinksAreNotSilentlyTreatedAsMedia() {
+        assertTrue(FamilyRouteProbePolicy.directMedia("https://example.org/a.MP4?k=1"));
+        assertTrue(FamilyRouteProbePolicy.directMedia("http://127.0.0.1/000.m3u8"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("https://example.org/watch?video=.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("https://user:secret@example.org/a.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("file:///tmp/a.mp4"));
+        assertFalse(FamilyRouteProbePolicy.directMedia("magnet:?xt=urn:btih:0"));
+    }
+
+    @Test public void autoRetryRequiresPermanentlyMissingDirectMediaWithoutOpaqueProvider() {
+        String media = "https://example.org/test09.mp4";
+        assertTrue(FamilyRouteProbePolicy.canAutoRetry(true, media, 1, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.canAutoRetry(false, media, 1, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.canAutoRetry(true, media, 4, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.canAutoRetry(true, media, 1, false, true, false));
+        assertFalse(FamilyRouteProbePolicy.canAutoRetry(true, "opaque-id", 1, false, false, false));
+    }
+
+    @Test public void scansCurrentEpisodeInReorderedAndShorterPlaylists() {
+        assertEquals(1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode01", "Episode09", "Episode02")));
+        assertEquals(0, FamilyRouteProbePolicy.episodeIndex("第９集", List.of("EP.09", "第10集")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode01")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("第10集", "第08集")));
+    }
+
+    @Test public void neverGuessesAnAmbiguousEpisodeOrMergesSeasonLabels() {
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("第09集", List.of("Episode 9", "第9话")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("Episode09", List.of("Episode09", "EPISODE09")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "Episode09")));
+        assertEquals(1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "S02E09")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("", List.of("")));
+    }
+
+    @Test public void directChecksRequireCatalogWithoutPluginExtensionOrHeaders() {
+        assertTrue(FamilyRouteProbePolicy.plainCatalog(1, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(3, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(0, true, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(1, false, true, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(1, false, false, true));
+    }
+
+    @Test public void matchesStayVisibleEvenWhenTheyCannotBeProbed() {
+        String url = "https://example.com/episode09.m3u8";
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.PROBE, FamilyRouteProbePolicy.localStatus(true, true, url, 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.MANUAL_ONLY, FamilyRouteProbePolicy.localStatus(true, false, url, 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.MANUAL_ONLY, FamilyRouteProbePolicy.localStatus(true, true, "opaque-id", 0));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.LIMIT_REACHED,
+                FamilyRouteProbePolicy.localStatus(true, true, url, FamilyRouteProbePolicy.LOCAL_ROUTE_LIMIT));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.NO_MATCH, FamilyRouteProbePolicy.localStatus(false, true, url, 0));
+    }
+
+    @Test public void selectingNeverFallsBackToADifferentEpisode() {
+        for (FamilyRouteProbePolicy.LocalStatus status : FamilyRouteProbePolicy.LocalStatus.values()) {
+            assertEquals(status.name(),
+                    status != FamilyRouteProbePolicy.LocalStatus.NO_MATCH && status != FamilyRouteProbePolicy.LocalStatus.PROBE,
+                    FamilyRouteProbePolicy.canSelect(status));
+        }
+    }
+
+    @Test public void crossSourceRequiresTheUniqueRequestedDetailRegardlessOfOrder() {
+        record Detail(String id, String title) {}
+        Detail unrelated = new Detail("other", "Same apparent title");
+        Detail requested = new Detail("wanted", "Same apparent title");
+        assertSame(requested, DetailIdentity.find("wanted", List.of(unrelated, requested), Detail::id));
+        assertNull(DetailIdentity.find("wanted", List.of(unrelated), Detail::id));
+        assertNull(DetailIdentity.find("wanted", List.of(requested, requested), Detail::id));
+        assertNull(DetailIdentity.find(" ", List.of(new Detail(" ", "No id")), Detail::id));
+    }
+
+    @Test public void catalogArtworkIndexDoesNotPromoteAmbiguousRows() {
+        record Detail(String id, String cover) {}
+        Detail valid = new Detail("valid", "real-cover");
+        var rows = DetailIdentity.indexUnique(List.of(new Detail("duplicate", "one"), valid,
+                new Detail("duplicate", "two"), new Detail("", "none"), new Detail("duplicate", "three")), Detail::id);
+        assertSame(valid, rows.get("valid"));
+        assertFalse(rows.containsKey("duplicate"));
+        assertFalse(rows.containsKey(""));
+    }
+
+    @Test public void crossSourceStartsAtActualEpisodeOneRatherThanFirstListEntry() {
+        assertEquals(2, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("预告片", "第9集", "ＥＰ０１")));
+        assertEquals(1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("Trailer", "第１话")));
+        assertEquals(1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("预告片", "正片")));
+    }
+
+    @Test public void crossSourceDoesNotGuessWhenTheStartIsAmbiguous() {
+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("Episode01", "第1集")));
+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("正片", "全片")));
+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("正片", "Episode02")));
+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("预告片", "HD")));
+        assertEquals(-1, FamilyRouteProbePolicy.initialEpisodeIndex(List.of("Trailer", "Season 2 Episode 1")));
+    }
+    @Test public void onlyExplicitAuthenticationResponseIsLabeledLoginRequired() {
+        for (int code : new int[]{0, 200, 403, 404, 408, 429, 500}) {
+            assertEquals(FamilyRouteProbePolicy.ProbeResult.UNVERIFIED, FamilyRouteProbePolicy.httpFailure(code));
+        }
+        assertEquals(FamilyRouteProbePolicy.ProbeResult.LOGIN_REQUIRED, FamilyRouteProbePolicy.httpFailure(401));
+        assertEquals(FamilyRouteProbePolicy.LocalStatus.LOGIN_REQUIRED,
+                FamilyRouteProbePolicy.localResult(FamilyRouteProbePolicy.ProbeResult.LOGIN_REQUIRED));
+        assertTrue(FamilyRouteProbePolicy.canSelect(FamilyRouteProbePolicy.LocalStatus.LOGIN_REQUIRED));
+    }
+}
