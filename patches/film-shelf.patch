+        progress.show();
+        familyScan.revalidate(outcome, verified -> {
+            if (familyScanDialog != progress || !familyResumed || isFinishing() || isDestroyed()) return;
+            cancelFamilyScan();
+            boolean playbackUnchanged = getKey().equals(sourceKey) && getId().equals(vodId)
+                    && (mEpisodeAdapter.getItemCount() > 0 ? getEpisode() : null) == episode
+                    && (mFlagAdapter.getItemCount() > 0 ? getFlag() : null) == flag;
+            if (verified == null || service() == null || familyLoginWait || !playbackUnchanged) {
