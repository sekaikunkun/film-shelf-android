+    private void showFamilyLocalResults(List<FamilyDirectRouteScan.LocalOutcome> results, Episode current,
+                                        Flag currentFlag, String sourceKey, String vodId, int skipped) {
+        CharSequence[] rows = results.stream().map(outcome -> outcome.route().flag() + "  ·  "
+                + (outcome.playable() ? "可播" : "未检测到可播画面")).toArray(CharSequence[]::new);
+        String title = "本集检测结果 · " + current.getName();
