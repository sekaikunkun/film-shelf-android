+
+    // Match labels, never a playlist position: lists can omit episodes or be reversed.
+    static int episodeIndex(String current, List<String> alternatives) {
+        String label = normalize(current);
+        if (label.isEmpty()) return -1;
+        int exact = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (!label.equals(normalize(alternatives.get(i)))) continue;
+            if (exact != -1) return -1;
+            exact = i;
+        }
+        if (exact != -1) return exact;
+        int number = episodeNumber(label);
+        if (number < 0) return -1;
+        int match = -1;
+        for (int i = 0; i < alternatives.size(); i++) {
+            if (number != episodeNumber(normalize(alternatives.get(i)))) continue;
+            if (match != -1) return -1;
+            match = i;
+        }
+        return match;
+    }
+
+    // Scan by episode identity, not display order: a playable trailer can be listed first.
+    static int initialEpisodeIndex(List<String> labels) {
+        int episodeOne = -1;
+        int fullFeature = -1;
+        boolean numbered = false;
+        for (int i = 0; i < labels.size(); i++) {
+            String label = normalize(labels.get(i));
+            int number = episodeNumber(label);
+            if (number >= 0) numbered = true;
+            if (number == 1) {
+                if (episodeOne >= 0) return -1;
+                episodeOne = i;
+            }
+            if (label.equals("正片") || label.equals("全片") || label.equals("full movie")
+                    || label.equals("full feature")) {
+                fullFeature = fullFeature == -1 ? i : -2;
+            }
+        }
