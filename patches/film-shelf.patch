+    private void startFamilyLocalScan() {
+        if (!familyResumed || isFinishing() || isDestroyed() || familyLoginWait
+                || mFlagAdapter.getItemCount() < 2 || mEpisodeAdapter.getItemCount() == 0) return;
+        Site site = getSite();
+        boolean plain = FamilyRouteProbePolicy.plainCatalog(site.getType(), !site.getExt().isEmpty(),
+                !site.getHeader().isEmpty(), !site.getPlayUrl().isEmpty());
+        String sourceKey = getKey();
+        String vodId = getId();
+        Episode current = getEpisode();
+        String episodeName = current.getName();
+        Flag currentFlag = getFlag();
+        List<FamilyLocalLine> lines = new ArrayList<>();
+        List<FamilyDirectRouteScan.Route> routes = new ArrayList<>();
+        for (Flag flag : mFlagAdapter.getItems()) {
+            if (flag == currentFlag || flag.isSelected()) continue;
+            List<Episode> episodes = flag.getEpisodes();
+            int index = FamilyRouteProbePolicy.episodeIndex(episodeName,
+                    episodes.stream().map(Episode::getName).collect(java.util.stream.Collectors.toList()));
+            Episode target = index < 0 ? null : episodes.get(index);
+            FamilyRouteProbePolicy.LocalStatus status = FamilyRouteProbePolicy.localStatus(
+                    target != null, plain, target == null ? null : target.getUrl(), routes.size());
+            lines.add(new FamilyLocalLine(flag, target, status));
+            if (status == FamilyRouteProbePolicy.LocalStatus.PROBE)
+                routes.add(new FamilyDirectRouteScan.Route(flag.getFlag(), target.getName(), target.getUrl()));
+        }
+        cancelFamilyScan();
+        if (routes.isEmpty()) {
+            showFamilyLocalResults(lines, current, currentFlag, sourceKey, vodId);
+            return;
+        }
+        AlertDialog progress = newFamilyScanProgress(getString(R.string.family_scan_episode_title, episodeName), false);
+        familyScan = new FamilyDirectRouteScan(this, routes, new FamilyDirectRouteScan.LocalListener() {
+            @Override public void progress(int done, int total, String route) {
+                updateFamilyScanProgress(progress, done, total, route);
+            }
+            @Override public void complete(List<FamilyDirectRouteScan.LocalOutcome> outcomes) {
+                if (familyScanDialog != progress || !familyResumed || isFinishing() || isDestroyed()) return;
+                cancelFamilyScan();
+                if (!isSameFamilyLocalPlayback(current, currentFlag, sourceKey, vodId)) return;
+                int probe = 0;
+                for (int i = 0; i < lines.size(); i++) {
+                    FamilyLocalLine line = lines.get(i);
+                    if (line.status() != FamilyRouteProbePolicy.LocalStatus.PROBE) continue;
+                    FamilyRouteProbePolicy.LocalStatus status =
+                            FamilyRouteProbePolicy.localResult(outcomes.get(probe++).result());
+                    lines.set(i, new FamilyLocalLine(line.flag(), line.episode(), status));
+                }
+                showFamilyLocalResults(lines, current, currentFlag, sourceKey, vodId);
+            }
+        });
+        progress.show();
+        familyScan.start();
+    }
