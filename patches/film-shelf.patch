+
+    static ProbeResult httpFailure(int responseCode) {
+        return responseCode == 401 ? ProbeResult.LOGIN_REQUIRED : ProbeResult.UNVERIFIED;
+    }
+
+    static LocalStatus localResult(ProbeResult result) {
+        return switch (result) {
+            case PLAYABLE -> LocalStatus.PLAYABLE;
+            case LOGIN_REQUIRED -> LocalStatus.LOGIN_REQUIRED;
+            case UNVERIFIED -> LocalStatus.UNVERIFIED;
+        };
+    }
+
+    static LocalStatus localStatus(boolean matched, boolean supported, int type, String url, int scheduled) {
+        if (!matched) return LocalStatus.NO_MATCH;
+        if (!supported || !canRequest(type, url)) return LocalStatus.MANUAL_ONLY;
+        return scheduled < LOCAL_ROUTE_LIMIT ? LocalStatus.PROBE : LocalStatus.LIMIT_REACHED;
+    }
+
+    static boolean canSelect(LocalStatus status) {
+        return status == LocalStatus.PLAYABLE || status == LocalStatus.MANUAL_ONLY
+                || status == LocalStatus.LIMIT_REACHED || status == LocalStatus.UNVERIFIED
+                || status == LocalStatus.LOGIN_REQUIRED;
+    }
+
+    static String identity(String site, String id) {
+        return site.length() + ":" + site + id;
