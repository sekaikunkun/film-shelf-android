+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "Episode09")));
+        assertEquals(1, FamilyRouteProbePolicy.episodeIndex("S02E09", List.of("S01E09", "S02E09")));
+        assertEquals(-1, FamilyRouteProbePolicy.episodeIndex("", List.of("")));
+    }
+
+    @Test public void directChecksRequireCatalogWithoutPluginExtensionOrHeaders() {
+        assertTrue(FamilyRouteProbePolicy.plainCatalog(1, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(3, false, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(0, true, false, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(1, false, true, false));
+        assertFalse(FamilyRouteProbePolicy.plainCatalog(1, false, false, true));
