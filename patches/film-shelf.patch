@@ -11,6 +12,27 @@ import java.util.List;
 @Dao
 public abstract class ConfigDao extends BaseDao<Config> {

+    // Room returns the generated key but does not update the object used by
+    // the active catalog. History and favorites need this ID before first use.
+    @Transaction
+    public void saveWithIdentity(Config item) {
+        if (item.getId() > 0) {
+            insertOrUpdate(item);
+            return;
+        }
+        item.setId(0);
+        long inserted = insert(item);
+        if (inserted > 0) {
+            item.setId(Math.toIntExact(inserted));
+            return;
+        }
+        Config saved = find(item.getUrl(), item.getType());
+        if (saved != null) {
+            item.setId(saved.getId());
+            update(item);
+        }
+    }
+
     @Query("SELECT * FROM Config")
     public abstract List<Config> findAll();

