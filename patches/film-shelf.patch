+    private void showFamilyLocalResults(List<FamilyLocalLine> lines, Episode current,
+                                        Flag currentFlag, String sourceKey, String vodId) {
+        CharSequence[] rows = lines.stream().map(line -> line.flag().getFlag() + "  ·  " + switch (line.status()) {
+            case PLAYABLE -> "已确认可播";
+            case MANUAL_ONLY -> "无法自动验证，可手动试播";
+            case LIMIT_REACHED, PROBE -> "未检测，可手动试播";
+            case LOGIN_REQUIRED -> getString(R.string.family_scan_login_required);
+            case UNVERIFIED -> "未确认可播，可手动试播";
+            case NO_MATCH -> "未找到匹配的本集";
+        }).toArray(CharSequence[]::new);
+        AlertDialog dialog = new MaterialAlertDialogBuilder(this)
+                .setTitle("本集线路 · " + current.getName())
+                .setItems(rows, null).setNegativeButton("返回", null).create();
+        familyScanDialog = dialog;
+        dialog.setOnDismissListener(dismissed -> {
+            if (familyScanDialog == dialog) familyScanDialog = null;
+        });
+        dialog.show();
+        dialog.getListView().setOnItemClickListener((parent, view, position, id) -> {
+            FamilyLocalLine line = lines.get(position);
+            if (!FamilyRouteProbePolicy.canSelect(line.status())) return;
+            cancelFamilyScan();
+            if (!isSameFamilyLocalPlayback(current, currentFlag, sourceKey, vodId)) {
+                Notify.show("播放内容已变化，请重新检测");
+                return;
+            }
+            for (Flag flag : mFlagAdapter.getItems()) {
+                if (flag != line.flag()) continue;
+                for (Episode episode : flag.getEpisodes()) {
+                    if (episode != line.episode()) continue;
+                    setAutoMode(false);
+                    selectFlagEpisode(flag, episode);
+                    return;
+                }
+            }
+            Notify.show("线路已更新，请重新检测");
+        });
+    }
