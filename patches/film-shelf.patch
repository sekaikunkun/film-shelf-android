+package com.fongmi.android.tv.utils;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RadialGradient;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.text.Layout;
+import android.text.StaticLayout;
+import android.text.TextPaint;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/**
+ * Artwork-free poster frame: a title-tinted dark gradient, a soft key light,
+ * a thin inset frame and the full title set bottom-left. Works at any aspect
+ * ratio, so the same drawable serves portrait cards and landscape heroes.
+ */
+public class PosterPlaceholder extends Drawable {
+
+    private final String title;
+    private final boolean showTitle;
+    private final int base;
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint light = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint frame = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint accent = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private StaticLayout layout;
+    private int layoutWidth = -1;
+    private int alpha = 255;
+
+    public PosterPlaceholder(@Nullable String title) {
+        this(title, true);
+    }
+
+    public PosterPlaceholder(@Nullable String title, boolean showTitle) {
+        this.title = TextUtils.isEmpty(title) ? "" : title.trim();
+        this.showTitle = showTitle && !this.title.isEmpty();
+        this.base = tint(this.title);
+        frame.setStyle(Paint.Style.STROKE);
+        frame.setColor(0x38FFFFFF);
+        accent.setColor(0xCCFFFFFF);
+        text.setColor(0xFFF5F2EC);
+        text.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        text.setShadowLayer(6, 0, 2, 0x66000000);
+    }
+
+    /** Deep, desaturated colour picked deterministically from the title. */
+    private static int tint(String title) {
+        float hue = title.isEmpty() ? 190 : (title.hashCode() & 0x7fffffff) % 360;
+        return Color.HSVToColor(new float[]{hue, 0.42f, 0.34f});
+    }
+
+    @Override
+    protected void onBoundsChange(@NonNull Rect bounds) {
+        int w = bounds.width(), h = bounds.height();
+        if (w <= 0 || h <= 0) return;
+        fill.setShader(new LinearGradient(0, 0, w * 0.35f, h, base, 0xFF0B0E10, Shader.TileMode.CLAMP));
+        light.setShader(new RadialGradient(w * 0.18f, h * 0.12f, Math.max(w, h) * 0.75f, 0x2EFFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
+        frame.setStrokeWidth(Math.max(1f, Math.min(w, h) * 0.008f));
+        layoutWidth = -1;
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        Rect b = getBounds();
+        int w = b.width(), h = b.height();
+        if (w <= 0 || h <= 0) return;
+        int save = canvas.save();
+        canvas.translate(b.left, b.top);
+        canvas.drawRect(0, 0, w, h, fill);
+        canvas.drawRect(0, 0, w, h, light);
+        float short_ = Math.min(w, h);
+        float inset = short_ * 0.06f;
+        float radius = short_ * 0.03f;
+        rect.set(inset, inset, w - inset, h - inset);
+        canvas.drawRoundRect(rect, radius, radius, frame);
+        if (showTitle) drawTitle(canvas, w, h, short_, inset);
+        canvas.restoreToCount(save);
+    }
+
+    private void drawTitle(Canvas canvas, int w, int h, float short_, float inset) {
+        float pad = inset + short_ * 0.07f;
+        int width = (int) (w - pad * 2);
+        if (width <= 0) return;
+        if (layout == null || layoutWidth != width) {
+            text.setTextSize(Math.max(10f, short_ * (title.length() > 8 ? 0.12f : 0.15f)));
+            layout = StaticLayout.Builder.obtain(title, 0, title.length(), text, width)
+                    .setAlignment(Layout.Alignment.ALIGN_NORMAL)
+                    .setLineSpacing(0, 1.05f)
+                    .setMaxLines(3)
+                    .setEllipsize(TextUtils.TruncateAt.END)
+                    .build();
+            layoutWidth = width;
+        }
+        float top = h - pad - layout.getHeight();
+        float bar = short_ * 0.012f;
+        canvas.drawRect(pad, top - bar * 5, pad + width * 0.22f, top - bar * 4, accent);
+        canvas.save();
+        canvas.translate(pad, top);
+        layout.draw(canvas);
+        canvas.restore();
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        this.alpha = alpha;
+        fill.setAlpha(alpha);
+        text.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getAlpha() {
+        return alpha;
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+        fill.setColorFilter(colorFilter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return alpha == 255 ? PixelFormat.OPAQUE : PixelFormat.TRANSLUCENT;
+    }
+}
