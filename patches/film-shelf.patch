+    private final FamilyPlaybackWait familyWait = new FamilyPlaybackWait();
+    private final Runnable familyTick = this::pollFamilyWait;
+    private AlertDialog familyDialog;
+    private boolean familyResumed;
+    private boolean familyLoginWait;
+    private boolean familyAuthNotice;
+    private String familyError;
+    private boolean familyErrorObscured;
+
+    private void scheduleFamilyTick() {
+        App.removeCallbacks(familyTick);
+        if (familyResumed && (familyWait.isActive() || familyError != null || familyAuthNotice))
+            App.post(familyTick, 500);
+    }
+
+    private FamilyDirectRouteScan familyScan;
+    private AlertDialog familyScanDialog;
+    private FamilyDirectRouteScan.Outcome familyScanSelection;
+
+    private void cancelFamilyScan() {
+        FamilyDirectRouteScan scan = familyScan;
+        familyScan = null;
+        if (scan != null) scan.close();
+        AlertDialog dialog = familyScanDialog;
+        familyScanDialog = null;
+        if (dialog != null) dialog.dismiss();
+    }
+
+    private void startFamilyLocalScan() {
+        if (!familyResumed || isFinishing() || isDestroyed() || familyLoginWait
+                || mFlagAdapter.getItemCount() < 2 || mEpisodeAdapter.getItemCount() == 0) return;
+        Site site = getSite();
+        if (!FamilyRouteProbePolicy.plainCatalog(site.getType(), !site.getExt().isEmpty(), !site.getHeader().isEmpty())) {
+            Notify.show("此来源需要解析或登录，请手动选择线路");
+            return;
+        }
+        String sourceKey = getKey();
+        String vodId = getId();
+        Episode current = getEpisode();
+        String episodeName = current.getName();
+        Flag currentFlag = getFlag();
+        List<FamilyDirectRouteScan.Route> routes = new ArrayList<>();
+        for (Flag flag : mFlagAdapter.getItems()) {
+            if (flag == currentFlag || flag.isSelected()) continue;
+            List<Episode> episodes = flag.getEpisodes();
+            int index = FamilyRouteProbePolicy.episodeIndex(episodeName,
+                    episodes.stream().map(Episode::getName).collect(java.util.stream.Collectors.toList()));
+            if (index < 0) continue;
+            Episode target = episodes.get(index);
+            if (!FamilyRouteProbePolicy.directMedia(target.getUrl())) continue;
+            routes.add(new FamilyDirectRouteScan.Route(flag.getFlag(), target.getName(), target.getUrl()));
+            if (routes.size() == FamilyRouteProbePolicy.LOCAL_ROUTE_LIMIT) break;
+        }
+        if (routes.isEmpty()) {
