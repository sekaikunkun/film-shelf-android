+package com.fongmi.android.tv.ui.filmshelf
+
+import android.view.ViewGroup
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.gestures.detectTapGestures
+import androidx.compose.foundation.interaction.MutableInteractionSource
+import androidx.compose.foundation.interaction.PressInteraction
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.BoxWithConstraints
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.RowScope
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.StrokeCap
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.ComposeView
+import androidx.compose.ui.platform.ViewCompositionStrategy
+import androidx.compose.ui.res.colorResource
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.tv.material3.ClickableSurfaceDefaults
+import androidx.tv.material3.MaterialTheme
+import androidx.tv.material3.Surface
+import androidx.tv.material3.Text
+import androidx.tv.material3.darkColorScheme
+import com.fongmi.android.tv.R
+
+/** Presentation only. The existing Activity owns all navigation and media actions. */
+object FilmShelfHome {
+    class Chrome internal constructor(private val view: ComposeView) {
+        internal var source by mutableStateOf("")
+        internal var searchFocusRequest by mutableIntStateOf(0)
+
+        fun setSourceTitle(title: String) { source = title }
+
+        fun requestSearchFocus() {
+            if (!view.isInTouchMode) searchFocusRequest++
+        }
+    }
+
+    @JvmStatic
+    fun attach(parent: ViewGroup, actions: Actions): Chrome {
+        val view = ComposeView(parent.context).apply {
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+            layoutParams = ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
+            )
+        }
+        val chrome = Chrome(view)
+        view.setContent {
+            FilmShelfTheme {
+                HomeChrome(chrome.source, chrome.searchFocusRequest, actions)
+            }
+        }
+        parent.addView(view)
+        return chrome
+    }
+
+    interface Actions {
+        fun search()
+        fun searchCurrentSource()
+        fun sources()
+        fun reloadSource()
+        fun favorites()
+        fun push()
+        fun settings()
+    }
+}
+
+private val Ink: Color @Composable get() = colorResource(R.color.film_flow_ink)
+private val Muted: Color @Composable get() = colorResource(R.color.film_flow_muted)
+private val Teal: Color @Composable get() = colorResource(R.color.film_flow_accent)
+private val OnAccent: Color @Composable get() = colorResource(R.color.film_flow_on_accent)
+private val Panel: Color @Composable get() = colorResource(R.color.film_flow_panel)
+private val FocusPanel = Color(0xFF35494C)
+private val Field = Color(0x14FFFFFF)
+private val OnFocus = Color(0xFF111619)
+
+@Composable
+internal fun FilmShelfTheme(content: @Composable () -> Unit) {
+    MaterialTheme(
+        colorScheme = darkColorScheme(
+            primary = Teal,
+            onPrimary = OnAccent,
+            background = colorResource(R.color.film_shelf_home_background),
+            onBackground = Ink,
+            surface = Panel,
+            onSurface = Ink,
+            onSurfaceVariant = Muted,
+        ),
+        content = content,
+    )
+}
+
+@Composable
+private fun HomeChrome(
+    source: String, searchFocusRequest: Int, actions: FilmShelfHome.Actions,
+) {
+    val searchFocus = remember { FocusRequester() }
+    BoxWithConstraints(Modifier.fillMaxWidth().padding(horizontal = 24.dp, vertical = 12.dp)) {
+        if (maxWidth < 570.dp) {
+            Column(verticalArrangement = Arrangement.spacedBy(9.dp)) {
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(12.dp),
+                ) {
+                    SourceButton(source, actions, Modifier.weight(0.9f))
+                    SearchButton(actions, Modifier.weight(1.3f).focusRequester(searchFocus))
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) { Utilities(actions) }
+            }
+        } else {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+                modifier = Modifier.fillMaxWidth(),
+            ) {
+                SourceButton(source, actions, Modifier.weight(0.9f))
+                SearchButton(actions, Modifier.weight(1.45f).focusRequester(searchFocus))
+                Utilities(actions)
+            }
+        }
+    }
+    LaunchedEffect(searchFocusRequest) {
+        if (searchFocusRequest != 0) searchFocus.requestFocus()
+    }
+}
+
+@Composable
+private fun SourceButton(source: String, actions: FilmShelfHome.Actions, modifier: Modifier) {
+    HomeAction(
+        modifier = modifier,
+        onClick = actions::sources,
+        onLongClick = actions::reloadSource,
+    ) {
+        Column(Modifier.padding(horizontal = 12.dp, vertical = 7.dp)) {
+            Text(
+                stringResource(R.string.film_shelf_home_brand),
+                style = MaterialTheme.typography.titleLarge,
+                fontWeight = FontWeight.Bold,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            Text(
+                source.ifBlank { stringResource(R.string.film_shelf_home_sources) },
+                style = MaterialTheme.typography.labelSmall,
+                color = androidx.tv.material3.LocalContentColor.current.copy(alpha = 0.62f),
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+@Composable
+private fun SearchButton(actions: FilmShelfHome.Actions, modifier: Modifier) {
+    HomeAction(
+        modifier = modifier,
+        onClick = actions::search,
+        onLongClick = actions::searchCurrentSource,
+        primary = true,
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+            modifier = Modifier.padding(horizontal = 14.dp, vertical = 8.dp),
+        ) {
+            val iconInk = androidx.tv.material3.LocalContentColor.current.copy(alpha = 0.8f)
+            Canvas(Modifier.size(18.dp)) {
+                val radius = size.minDimension * 0.3f
+                val center = Offset(size.width * 0.43f, size.height * 0.43f)
+                drawCircle(iconInk, radius, center, style = Stroke(1.8.dp.toPx()))
+                drawLine(iconInk, center + Offset(radius * .72f, radius * .72f),
+                    Offset(size.width * .86f, size.height * .86f), 1.8.dp.toPx(), StrokeCap.Round)
+            }
+            Text(
+                stringResource(R.string.film_shelf_home_search),
+                style = MaterialTheme.typography.labelLarge,
+                fontWeight = FontWeight.Normal,
+                color = androidx.tv.material3.LocalContentColor.current.copy(alpha = 0.8f),
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+@Composable
+private fun RowScope.Utilities(actions: FilmShelfHome.Actions) {
+    Utility(R.string.film_shelf_home_library, actions::favorites)
+    Utility(R.string.home_push, actions::push)
+    Utility(R.string.film_shelf_home_settings, actions::settings)
+}
+
+@Composable
+private fun Utility(text: Int, action: () -> Unit) {
+    HomeAction(onClick = action) {
+        Text(
+            stringResource(text),
+            modifier = Modifier.padding(horizontal = 14.dp),
+            style = MaterialTheme.typography.labelLarge,
+            maxLines = 1,
+        )
+    }
+}
+
+@Composable
+private fun HomeAction(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    onLongClick: (() -> Unit)? = null,
+    primary: Boolean = false,
+    content: @Composable () -> Unit,
+) {
+    val interactions = remember { MutableInteractionSource() }
+    val currentClick by rememberUpdatedState(onClick)
+    val currentLongClick by rememberUpdatedState(onLongClick)
+    val supportsLongClick = onLongClick != null
+    // TV Material's Surface handles Center/Enter and accessibility activation.
+    // Add a separate pointer gesture; keyboard input never fires this callback.
+    val touch = Modifier.pointerInput(interactions, supportsLongClick) {
+        detectTapGestures(
+            onPress = { position ->
+                val event = PressInteraction.Press(position)
+                interactions.tryEmit(event)
+                try {
+                    val completed = tryAwaitRelease()
+                    interactions.tryEmit(if (completed) PressInteraction.Release(event)
+                        else PressInteraction.Cancel(event))
+                } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                    interactions.tryEmit(PressInteraction.Cancel(event))
+                    throw cancelled
+                }
+            },
+            onTap = { currentClick() },
+            onLongPress = if (supportsLongClick) { { currentLongClick?.invoke() } } else null,
+        )
+    }
+    Surface(
+        onClick = onClick,
+        onLongClick = onLongClick,
+        interactionSource = interactions,
+        modifier = modifier.heightIn(min = 48.dp).then(touch),
+        // Quiet at rest (search is the only filled field); a light fill marks focus.
+        shape = ClickableSurfaceDefaults.shape(RoundedCornerShape(24.dp)),
+        colors = ClickableSurfaceDefaults.colors(
+            containerColor = if (primary) Field else Color.Transparent,
+            contentColor = Ink,
+            focusedContainerColor = Ink,
+            focusedContentColor = OnFocus,
+            pressedContainerColor = Ink.copy(alpha = 0.85f),
+            pressedContentColor = OnFocus,
+        ),
+        scale = ClickableSurfaceDefaults.scale(focusedScale = 1.03f),
+    ) {
+        androidx.compose.foundation.layout.Box(
+            modifier = Modifier.heightIn(min = 48.dp),
+            contentAlignment = Alignment.CenterStart,
+        ) { content() }
+    }
+}
