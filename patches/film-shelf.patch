@@ -0,0 +1,55 @@
+package com.fongmi.android.tv.ui.custom;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.leanback.widget.VerticalGridView;
+
+/**
+ * Leanback's multi-column VerticalGridView also reports horizontal scrolling,
+ * so a touch drag can slide the whole grid sideways. Episode tiles should
+ * only scroll vertically: pin the scroll gesture's x to where it started.
+ * Child taps and D-pad navigation are unaffected.
+ */
+public class VerticalOnlyGridView extends VerticalGridView {
+
+    private float downX;
+
+    public VerticalOnlyGridView(@NonNull Context context) {
+        super(context);
+    }
+
+    public VerticalOnlyGridView(@NonNull Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    public VerticalOnlyGridView(@NonNull Context context, @Nullable AttributeSet attrs, int defStyle) {
+        super(context, attrs, defStyle);
+    }
+
+    @Override
+    public boolean onInterceptTouchEvent(MotionEvent e) {
+        return withLockedX(e, true);
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        return withLockedX(e, false);
+    }
+
+    private boolean withLockedX(MotionEvent e, boolean intercept) {
+        if (e.getActionMasked() == MotionEvent.ACTION_DOWN) downX = e.getX();
+        MotionEvent locked = MotionEvent.obtain(e);
+        locked.setLocation(downX, e.getY());
+        try {
+            return intercept ? super.onInterceptTouchEvent(locked) : super.onTouchEvent(locked);
+        } finally {
+            locked.recycle();
+        }
+    }
+}
